rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Keep this in sync with ADMIN_EMAILS in src/components/AdminRoute.jsx —
    // it's the same owner-access list, enforced here at the database level
    // instead of just in the UI.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ["info@yourbds.com"];
    }

    match /bookings/{bookingId} {
      // Booking is open to guests too (see BookingPage.jsx), so anyone can
      // create one — but not read, update, or delete other people's bookings.
      allow create: if true;

      // Fetching ONE booking by its exact ID is allowed for anyone — needed
      // by guests landing on the post-Stripe-payment success page
      // (BookingSuccess.jsx), which has no login of its own. This is safe
      // because Firestore's auto-generated IDs are effectively unguessable;
      // nobody can browse/enumerate bookings this way. Querying/listing the
      // whole collection stays restricted to the admin or the owning user.
      allow get: if true;
      allow list: if isAdmin() ||
        (request.auth != null && request.auth.uid == resource.data.userId);

      // The admin can update anything (status changes, session edits in
      // AdminPage.jsx); a logged-in user can update their own booking.
      //
      // Anyone — including guests — may flip `postPaymentProcessed` to
      // true (and record the Google Calendar sync result alongside it),
      // but ONLY once `paymentStatus` is already "paid", and ONLY those
      // two fields. `paymentStatus` itself can only ever be set to "paid"
      // by the Stripe webhook (functions/index.js — uses the Admin SDK,
      // which bypasses these rules entirely), never by a client. That
      // keeps this one client-writable field from ever being used to fake
      // a payment.
      //
      // A still-pending, not-yet-paid booking can also be overwritten by
      // anyone who knows its exact ID — the same "unguessable ID" trust
      // level `allow get` above already grants for reading it (these IDs
      // are random UUIDs/auto-IDs, not sequential or guessable). This
      // covers two guest-facing cases BookingPage.jsx relies on: (1) a
      // slow-connection retry safely re-saving the same booking instead of
      // creating a duplicate, and (2) recording each session's Google
      // Calendar sync result once it resolves. It closes the moment an
      // admin confirms/cancels the booking or payment completes.
      allow update: if isAdmin() ||
        (request.auth != null && request.auth.uid == resource.data.userId) ||
        (resource.data.paymentStatus == "paid" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["postPaymentProcessed", "sessions"]) &&
          request.resource.data.postPaymentProcessed == true) ||
        (resource.data.status == "pending" && resource.data.paymentStatus != "paid");

      // Only the admin can permanently delete a booking (AdminPage.jsx's
      // "Delete Permanently" button, gated behind a typed confirmation).
      allow delete: if isAdmin();
    }

    match /outboundClicks/{clickId} {
      // Logs when a visitor is redirected to a partner site (e.g. Bay
      // Pass Driving School's online course — see src/pages/GoRedirect.jsx).
      // Write-only from the client: anyone can log a click, nobody but
      // the admin can read the list back (it's just internal analytics,
      // not something a visitor needs to see).
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
